#!/usr/bin/env bash
# Answer a parked request: sign in one process, submit in another.
#
# The split is the point, not an accident of scripting. `stozher-kernel decide` reads the approver's
# own owner-only seed, signs, and prints — it opens no socket and needs no kernel configuration.
# `stozher-kernel answer` takes that object over an authenticated channel and hands it to the
# console — it holds no key and cannot produce a signature. Signing has no network; the network has
# no key. That separation is what makes "the kernel cannot manufacture an approval" (ADR-0009 §2) a
# structural fact rather than a promise, and this script is careful not to be the place it stops
# being true.
#
# The signed object never touches disk. It goes through a pipe, so there is no window in which an
# approval is sitting in a file waiting for someone to notice it.
#
# Usage:
#   bin/stozher-approve <request-hash> --root human:ivan [--minutes 15]
#   bin/stozher-approve <request-hash> --root human:ivan --deny "why not"

set -euo pipefail

DEPLOY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DEPLOY"

# Resolved from the running container below, never assumed. `bin/stozher-bootstrap` and
# `bin/stozher-restore` both already did this; this script did not, and a hardcoded
# `stozher_default` is wrong for every install that set `COMPOSE_PROJECT_NAME` — it either attaches
# the submitting container to the *other* install's network, so one deployment's approval is
# delivered to another deployment's kernel, or to a network that does not exist at all.
NETWORK=""
SEED="secrets/operator/operator.seed"
REQUEST=""
ROOT=""
DENY=""
MINUTES="15"

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --deny) DENY="$2"; shift 2 ;;
    --minutes) MINUTES="$2"; shift 2 ;;
    --key) SEED="$2"; shift 2 ;;
    -h|--help) sed -n '2,22p' "$0"; exit 0 ;;
    -*) echo "unknown argument $1" >&2; exit 2 ;;
    *) REQUEST="$1"; shift ;;
  esac
done

[ -n "$REQUEST" ] || { echo "usage: bin/stozher-approve <request-hash> --root human:<name>" >&2; exit 2; }
[ -n "$ROOT" ] || { echo "--root human:<name> is required — an approval is one named human's" >&2; exit 2; }
[ -f "$SEED" ] || { echo "$SEED does not exist: this is not the approver's machine" >&2; exit 2; }
[ -f .env ] || { echo ".env is missing — run bin/stozher-bootstrap first" >&2; exit 2; }

# shellcheck disable=SC1091
set -a; . ./.env; set +a

# Resolved AFTER .env, never before. The ceremony writes STOZHER_KERNEL_IMAGE into .env so that
# two installs on one host do not share a tag; read earlier, that assignment is invisible and
# every one of these commands silently runs the *other* deployment's binary against this
# deployment's kernel. It presented as `unknown command "anchor"` — a command this repository
# ships, executed from an image built before it existed.
IMAGE="${STOZHER_KERNEL_IMAGE:-stozher-kernel:0.1.0}"
UID_GID="$(id -u):$(id -g)"

# The network this project's kernel is actually on, asked of docker. `.env` is sourced first because
# compose interpolates the whole file on every invocation and `user:` has no default, and because
# `COMPOSE_PROJECT_NAME` — if this install set one — has to be in the environment before `ps`.
CONTAINER="$(docker compose ps -q kernel)"
[ -n "$CONTAINER" ] || { echo "the kernel container is not running — start it with 'docker compose up -d kernel'" >&2; exit 1; }
NETWORK="$(docker inspect -f '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{end}}' "$CONTAINER")"
[ -n "$NETWORK" ] || { echo "the kernel container is on no network" >&2; exit 1; }

verdict=(--approve)
[ -n "$DENY" ] && verdict=(--deny "$DENY")

# The approver's own process. `--role 0 --index 0` is the human root key the ceremony enrolled;
# `decide` defaults to role 1', which is an agent subject key and is not in any root set.
#
# `--config` because an approval is stamped with a fifteen-minute window and this deployment may be
# running its clock ahead (ADR-0023). Without it the window is the host's, the kernel is past it on
# arrival, and the approval is refused `gate-approval-expired` — after `answer` has already recorded
# it, which consumes the pending item: `console-csrf-invalid` on any retry, and the request has to
# be re-minted with a fresh nonce. One shipped command, and the gate request is dead. On a
# deployment that declares no advance the flag changes nothing.
#
# Conditional because an approver may hold nothing but their seed: §2's ceremony has them run this
# on their own machine, and a deployment configuration is not theirs to have. Absent, the host clock
# is the right answer — it is only an advanced deployment that needs telling.
deployment=()
[ -f config/kernel-config.json ] && deployment=(--config config/kernel-config.json)
signed="$(docker run --rm -i -u "$UID_GID" -v "$DEPLOY:/work" -w /work "$IMAGE" \
  decide "${deployment[@]}" \
         --request "$REQUEST" --key "$SEED" --role 0 --index 0 --minutes "$MINUTES" "${verdict[@]}")"

# A different process, with no seed mounted, carrying an object it could not have produced.
printf '%s' "$signed" | docker run --rm -i -u "$UID_GID" --network "$NETWORK" \
  -e STOZHER_KERNEL_TOKEN="$STOZHER_KERNEL_TOKEN" "$IMAGE" \
  answer --url http://kernel:8787 --request "$REQUEST"
