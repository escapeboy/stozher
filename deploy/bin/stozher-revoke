#!/usr/bin/env bash
# Revoke a mandate: sign in one process, submit in another.
#
# The same split as bin/stozher-approve, and for the same reason. `stozher-kernel revoke` reads the
# revoker's own owner-only seed, signs the revocation object, and prints it — it opens no socket and
# needs no kernel configuration. `stozher-kernel submit-revocation` takes that object over an
# authenticated channel and hands it to POST /v1/revocations — it holds no key and cannot produce a
# signature. Signing has no network; the network has no key.
#
# This command did not exist until §03 §7 nested the signed object inside the envelope. While the
# envelope *was* the revocation, its signature covered `stream`, `seq` and `prev-hash` — values only
# the kernel knows at append — so revoking meant holding the seed and a connection to the kernel in
# one process. The person most likely to need to revoke is a root whose seed exists on one laptop,
# which is exactly the person that shape excluded.
#
# Reaching the route is not being allowed to revoke. The kernel wraps the object for chain position
# and re-checks the inner signature against the mandate's grantor chain and the root set, so the
# deployment credential this script uses buys delivery and nothing else.
#
# The signed object never touches disk. It goes through a pipe.
#
# Usage:
#   bin/stozher-revoke <mandate-id> --root human:ivan --reason "laptop lost"
#   bin/stozher-revoke <mandate-id> --key secrets/operator/other.seed --role 2 --index 0

set -euo pipefail

DEPLOY="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$DEPLOY"

SEED="secrets/operator/operator.seed"
MANDATE=""
ROOT=""
REASON=""
# A root enrolled by the ceremony holds its key at role 0'; `revoke` defaults to role 1', which is an
# agent subject key and is in no root set. --role/--index are here for a grantor that is not a root.
ROLE="0"
INDEX="0"

while [ $# -gt 0 ]; do
  case "$1" in
    --root) ROOT="$2"; shift 2 ;;
    --reason) REASON="$2"; shift 2 ;;
    --key) SEED="$2"; shift 2 ;;
    --role) ROLE="$2"; shift 2 ;;
    --index) INDEX="$2"; shift 2 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    -*) echo "unknown argument $1" >&2; exit 2 ;;
    *) MANDATE="$1"; shift ;;
  esac
done

[ -n "$MANDATE" ] || { echo "usage: bin/stozher-revoke <mandate-id> --root human:<name>" >&2; exit 2; }
[ -n "$ROOT" ] || { echo "--root human:<name> is required — a revocation is one named human's" >&2; exit 2; }
[ -f "$SEED" ] || { echo "$SEED does not exist: this is not the revoker's machine" >&2; exit 2; }
[ -f .env ] || { echo ".env is missing — run bin/stozher-bootstrap first" >&2; exit 2; }

# shellcheck disable=SC1091
set -a; . ./.env; set +a

# Resolved AFTER .env, never before. The ceremony writes STOZHER_KERNEL_IMAGE into .env so that
# two installs on one host do not share a tag; read earlier, that assignment is invisible and
# every one of these commands silently runs the *other* deployment's binary against this
# deployment's kernel. It presented as `unknown command "anchor"` — a command this repository
# ships, executed from an image built before it existed.
IMAGE="${STOZHER_KERNEL_IMAGE:-stozher-kernel:0.1.0}"
UID_GID="$(id -u):$(id -g)"

# The network this project's kernel is actually on, asked of docker. A hardcoded `stozher_default`
# is wrong for every install that set `COMPOSE_PROJECT_NAME`, and delivering one deployment's
# revocation to another deployment's kernel is the worst available version of that mistake.
CONTAINER="$(docker compose ps -q kernel)"
[ -n "$CONTAINER" ] || { echo "the kernel container is not running — start it with 'docker compose up -d kernel'" >&2; exit 1; }
NETWORK="$(docker inspect -f '{{range $name, $_ := .NetworkSettings.Networks}}{{$name}}{{end}}' "$CONTAINER")"
[ -n "$NETWORK" ] || { echo "the kernel container is on no network" >&2; exit 1; }

reason=()
[ -n "$REASON" ] && reason=(--reason "$REASON")

# The revoker's own process.
signed="$(docker run --rm -i -u "$UID_GID" -v "$DEPLOY:/work" -w /work "$IMAGE" \
  revoke --mandate "$MANDATE" --key "$SEED" --role "$ROLE" --index "$INDEX" "${reason[@]}")"

# A different process, with no seed mounted, carrying an object it could not have produced.
printf '%s' "$signed" | docker run --rm -i -u "$UID_GID" --network "$NETWORK" \
  -e STOZHER_KERNEL_TOKEN="$STOZHER_KERNEL_TOKEN" "$IMAGE" \
  submit-revocation --url http://kernel:8787

# §03 §7 states what this costs the emitter, and an operator who learns it from a stopped component
# learns it too late: between now and the emitter's next revocation-feed pull, every envelope it
# builds under this mandate is refused, and §04 §3 admits no gap — its stream is wedged at that
# position until an operator intervenes. Nothing is lost and nothing is silently accepted.
echo "revoked. the holder's stream will wedge on its next append until it re-reads /v1/revocations" >&2
