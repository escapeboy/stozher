#!/usr/bin/env python3
"""Open the console in a browser, without giving the kernel a second way to be logged into.

Why this exists
---------------
The console authenticates exactly as every other route does: the `Bearer` credential of
`spec/05 §2.2`. That is a deliberate constraint — "do not invent a second auth scheme" — and it has
one awkward consequence a browser cannot work around, because a browser will not attach an
`Authorization` header to an address bar navigation. ADR-0008 recorded the gap and left the console
session scheme as an S5 decision.

**The S5 decision is: not yet, and here is the interim.** The reasoning is in the S5 ADR; the short
version is that a session cookie would buy browser access to a *read-only* view while adding a
second credential path to the kernel, and the friction worth removing — one-click approve — needs
browser-side Ed25519 signing with a per-device approver key enrolled in the root set. That is a key
lifecycle decision, not a packaging one, and shipping half of the pair leaves the friction in place
while paying the whole cost.

So the header injection ADR-0008 describes runs *here*, on the operator's laptop, for as long as
this process is in the foreground. It is not a deployed service and not a third container: nothing
about the running system changes, and closing this window closes the access.

What it will not do
-------------------
* It binds 127.0.0.1 only, and refuses to start otherwise. A header-injecting proxy reachable from
  the network is an unauthenticated console for everyone who can reach it.
* It answers only for its own address. Binding loopback is not a boundary on its own: any page the
  operator visits can re-resolve its own domain to 127.0.0.1 once the TTL expires, become
  same-origin with this port, and *read* what it fetches — and what it would fetch is
  `/console/audit`. The one header that still distinguishes that page from the operator's own tab
  is `Host`, so a `Host` this proxy does not answer for is refused before the credential is spent,
  as is an `Origin` or `Referer` from anywhere else.
* It never writes the token anywhere and never logs it.
* It forwards `GET` only. The one mutating console route takes a signed decision object, and that
  belongs in `bin/stozher-approve`, where the signing key and the network stay in separate
  processes (ADR-0009 §2). A browser proxy that could POST would be the shortest path to
  re-inventing the thing this file exists to avoid.

Usage: bin/stozher-console [--port 8788] [--no-open]
"""

from __future__ import annotations

import argparse
import http.server
import os
import sys
import urllib.error
import urllib.parse
import urllib.request
import webbrowser
from pathlib import Path

DEPLOY = Path(__file__).resolve().parent.parent
HOP_BY_HOP = {"connection", "keep-alive", "transfer-encoding", "upgrade", "te", "trailer"}

# The console is server-rendered HTML with one inline stylesheet, two `GET`/`POST` forms of its own
# and no scripts at all (`console/templates/`), so it needs nothing from anywhere. Saying so is
# defence in depth behind the `Host` check, not a replacement for it — a CSP does not stop a rebound
# page from fetching this origin, it stops what it could do with a page it did load.
CSP = (
    "default-src 'none'; style-src 'unsafe-inline'; form-action 'self'; "
    "frame-ancestors 'none'; base-uri 'none'"
)


def read_env() -> dict[str, str]:
    path = DEPLOY / ".env"
    if not path.is_file():
        sys.exit(f"{path} is missing — run bin/stozher-bootstrap first")
    values: dict[str, str] = {}
    for line in path.read_text(encoding="utf-8").splitlines():
        line = line.strip()
        if line and not line.startswith("#") and "=" in line:
            name, _, value = line.partition("=")
            values[name.strip()] = value.strip()
    return values


def build_server(port: int, upstream: str, token: str) -> http.server.ThreadingHTTPServer:
    """The proxy as an object, so its guards can be exercised without a browser or a kernel."""
    # Exact strings, not a suffix or a substring test: `evil.example` and `127.0.0.1.evil.example`
    # both fail this and both are what a rebinding page sends. The bare forms are here for an
    # operator who ran this on port 80, where a browser omits the port entirely.
    allowed_hosts = {f"127.0.0.1:{port}", f"localhost:{port}", "127.0.0.1", "localhost"}
    allowed_origins = {f"http://127.0.0.1:{port}", f"http://localhost:{port}"}

    class Handler(http.server.BaseHTTPRequestHandler):
        # A 1.0 client would make the browser close the connection per request; the console is a
        # handful of small pages either way, and 1.1 keeps the proxy honest about lengths.
        protocol_version = "HTTP/1.1"

        def do_GET(self) -> None:  # noqa: N802 - BaseHTTPRequestHandler's spelling
            if not self._is_the_operators_own_browser():
                return
            target = self.path if self.path.startswith("/") else "/"
            request = urllib.request.Request(upstream + target, method="GET")
            request.add_header("Authorization", f"Bearer {token}")
            try:
                with urllib.request.urlopen(request, timeout=30) as response:
                    self._relay(response.status, response.headers.items(), response.read())
            except urllib.error.HTTPError as e:
                self._relay(e.code, e.headers.items(), e.read())
            except OSError as e:
                # Never the token, never the upstream credential — just what went wrong.
                body = f"the kernel is not answering at {upstream}: {e}".encode()
                self._relay(502, [("Content-Type", "text/plain; charset=utf-8")], body)

        def _is_the_operators_own_browser(self) -> bool:
            """Refuse anything addressed to a name this proxy does not answer for.

            This is the whole DNS-rebinding defence. The socket says loopback for the operator's
            tab and for a rebound attacker page alike; `Host` is what still tells them apart, and
            the credential must not be spent before it has been read.
            """
            host = self.headers.get("Host", "")
            if host not in allowed_hosts:
                self._refuse(f"this proxy does not answer for {host!r}")
                return False
            for name in ("Origin", "Referer"):
                stated = self.headers.get(name)
                if stated is None:
                    continue
                parts = urllib.parse.urlsplit(stated)
                origin = f"{parts.scheme}://{parts.netloc}" if parts.scheme else stated
                if origin not in allowed_origins:
                    self._refuse(f"{name} names a different origin")
                    return False
            return True

        def _refuse(self, detail: str) -> None:
            self._relay(
                403, [("Content-Type", "text/plain; charset=utf-8")], f"{detail}\n".encode()
            )

        def _relay(self, status: int, headers: object, body: bytes) -> None:
            self.send_response(status)
            for name, value in headers:  # type: ignore[attr-defined]
                if name.lower() not in HOP_BY_HOP and name.lower() != "content-length":
                    self.send_header(name, value)
            self.send_header("X-Frame-Options", "DENY")
            self.send_header("Content-Security-Policy", CSP)
            self.send_header("Content-Length", str(len(body)))
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, fmt: str, *given: object) -> None:
            # Paths only. A console URL carries stream names and envelope ids, never a credential,
            # but the default format string is noisy enough to bury the one line that matters.
            sys.stderr.write(f"  {fmt % given}\n")

    return http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)


def main() -> int:
    parser = argparse.ArgumentParser(description="browse the Stozher console")
    parser.add_argument("--port", type=int, default=8788, help="local port to listen on")
    parser.add_argument("--no-open", action="store_true", help="do not launch a browser")
    args = parser.parse_args()

    env = read_env()
    token = env.get("STOZHER_KERNEL_TOKEN", "")
    if not token:
        sys.exit("STOZHER_KERNEL_TOKEN is not in .env — the console would refuse every request")
    upstream = f"http://127.0.0.1:{env.get('STOZHER_KERNEL_PORT', '8787')}"

    server = build_server(args.port, upstream, token)
    url = f"http://127.0.0.1:{args.port}/console"
    print(f"console at {url}")
    print("This process holds the kernel credential. Closing it closes the access.  Ctrl-C to stop.")
    if not args.no_open and os.environ.get("DISPLAY", "unset") != "":
        webbrowser.open(url)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    finally:
        server.server_close()
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
