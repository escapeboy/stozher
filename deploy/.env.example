# `bin/stozher-bootstrap` writes the real `.env` (mode 0600, git-ignored). This file documents what
# ends up in it and what the optional entries do. Copy nothing from here by hand; the ceremony
# generates every credential, because a credential a human typed is a credential a human can reuse.

# The operator's own uid/gid. A bind-mounted seed at mode 0600 is readable by exactly one account,
# and the kernel refuses to start on anything more permissive (spec 09 section 8), so both sides of
# the mount have to agree on who that account is.
#
# REQUIRED, with no default. Both containers declare `user:` with no fallback, so an incomplete
# .env makes `docker compose up` stop with a message rather than run the kernel as root beside the
# cap_drop and no-new-privileges that exist to prevent exactly that.
STOZHER_UID=1000
STOZHER_GID=1000

# Optional. Set this to run two installs on one host: it renames the compose project, so the
# containers, the network and the volumes of each are separate. Neither service pins a
# container_name, so nothing else has to change.
#
# Set it BEFORE the ceremony. bin/stozher-bootstrap rewrites this file — every credential below is
# generated, so it has to — but it reads this key back out first and re-emits it, along with the
# four channel credentials below. Give each install its own STOZHER_KERNEL_PORT too; both publish on
# 127.0.0.1 and two of them cannot share one.
# COMPOSE_PROJECT_NAME=stozher

# Published on 127.0.0.1 only. Exposing it further is a decision to make with a TLS terminator in
# front (spec 09 section 8 requires TLS for component-to-kernel traffic; this image terminates none).
STOZHER_KERNEL_PORT=8787

# The gateway presents this to the kernel (spec 05 section 2.2). The kernel's configuration holds
# only its SHA-256; this is the only place the token itself lives.
STOZHER_KERNEL_TOKEN=

# The MCP client presents this to the gateway. Same rule, one layer out (spec 10 section 1.1).
STOZHER_GATEWAY_CALLER=claude-code
STOZHER_GATEWAY_CALLER_TOKEN=

# --- optional: the approver ping (ADR-0002 allows exactly these three channels) ---------------
# Set the ones you configure a `notifications` entry for in config/kernel-config.json. A channel
# names the *variable*, never the value, so the configuration file stays safe to copy and diff.
# STOZHER_SLACK_WEBHOOK=
# STOZHER_WEBHOOK_URL=
# STOZHER_WEBHOOK_TOKEN=
# STOZHER_SMTP_PASSWORD=
