# --- keys: never commit key material of any kind ---
*.key
*.pem
*.p8
*.pk8
*.jwk
*.seed
keys/
secrets/
*.privkey
*.private
root-key*
operator-key*

# --- stores: event store / db artifacts ---
# Runtime data directories are ANCHORED to the repo root with a leading slash.
# An unanchored `store/` matches a directory of that name at ANY depth, which
# silently excluded kernel/stozher-kernel/src/store/ during S1 — source that
# built locally but was missing from a clean clone. Keep these anchored.
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
/store/
/data/
/var/
/deploy/store/
/deploy/data/

# --- env / config with secrets ---
.env
.env.*
!.env.example
*.local.toml

# --- build artifacts ---
target/
**/target/
Cargo.lock.bak
__pycache__/
*.py[cod]
.venv/
venv/
dist/
build/
*.egg-info/
node_modules/

# --- tooling / os ---
.DS_Store
.pytest_cache/
.ruff_cache/
.mypy_cache/
.serena/
*.log
